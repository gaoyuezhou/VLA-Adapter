# Machine-specific settings for the slurm scripts in this directory. Edit for your cluster.
# Every *.sbatch here sources this file. Partition/GPU/mem/time live in the #SBATCH headers of each script
# (override at submit time, e.g. `sbatch --partition=X --gres=gpu:8 slurm/finetune.sbatch ...`).
export REPO_DIR="${REPO_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"   # this repo
export CONDA_SH="${CONDA_SH:-/mnt/vast/home/gaoyue/miniforge3/etc/profile.d/conda.sh}"
export CONDA_ENV="${CONDA_ENV:-vla-adapter}"
export EXP_ROOT="${EXP_ROOT:-/mnt/vast/home/gaoyue/exps/vla_adapter}"           # smoke runs, eval logs (training run_root_dir is in configs/env_vars/env_vars.yaml)
export UPSTREAM_LIBERO_CONFIG="${UPSTREAM_LIBERO_CONFIG:-/mnt/vast/home/gaoyue/Repos/LIBERO/.libero_config}"  # only for eval_rlds_libero.sbatch
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl
